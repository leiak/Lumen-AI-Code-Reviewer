# =============================================================================
# Lumen AI Code Reviewer — API keys
# =============================================================================
# 复制本文件为 .env 并填入真实 key：
#   cp .env.example .env       (Git Bash / WSL / macOS)
#   copy .env.example .env     (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
#
# Spring Boot 通过 application.yml 顶部的 spring.config.import 自动加载本文件。
# 不配的 provider 会被 @ConditionalOnExpression 跳过，不会启动失败。
# =============================================================================

# --- Anthropic (Claude) ---
# 申请：https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- OpenAI (GPT) ---
# 申请：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Ollama (本地 LLM) ---
# 启动：ollama serve（默认 :11434），先 ollama pull qwen2.5-coder:32b
# 不需要 key，只要服务在跑就会被自动检测
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:32b

# --- DeepSeek ---
# 申请：https://platform.deepseek.com/api_keys
# OpenAI 兼容 API，base-url / model 可选
# 注意：base-url 不要带 /v1（Spring AI 会自动拼 /v1/chat/completions）
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# --- MiniMax ---
# 申请：https://api.minimax.chat/user-center/basic-information/interface-key
# OpenAI 兼容 API，base-url / model 可选
# 注意：base-url 不要带 /v1
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.chat
# MINIMAX_MODEL=MiniMax-Text-01

# =============================================================================
# 可选：数据目录（默认 ./.review-data）
# REVIEW_DATA_DIR=./.review-data
# =============================================================================
